# IMPORTANT: Replace these values before deploying!

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas Dashboard
MONGO_URL=mongodb+srv://platinum_admin:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/platinum_network?retryWrites=true&w=majority

# Database Name
DB_NAME=platinum_network

# CORS Origins - Add your domain after deployment
# Use * for testing, then update to your actual domain
CORS_ORIGINS=*

# JWT Secret Key - Change this to a random strong string!
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_STRONG_KEY_12345678_VERY_SECRET

# Port (Railway automatically sets this)
PORT=8001
